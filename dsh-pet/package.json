{
  "name": "dsh-pet",
  "version": "0.4.4",
  "description": "一只住在桌面上的透明动画桌宠：一百余段手绘风动画、拖拽甩抛、多开漫游，还能查余额、碎碎念、陪你聊天。不依赖任何 Agent 框架，双击即用。",
  "keywords": [
    "desktop-pet",
    "pet",
    "electron",
    "floating-widget",
    "transparent-window",
    "deepseek"
  ],
  "homepage": "https://github.com/luoqingciya/dsh-pet#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/luoqingciya/dsh-pet.git"
  },
  "bugs": {
    "url": "https://github.com/luoqingciya/dsh-pet/issues"
  },
  "_comment": [
    "=============== dsh-pet 包清单说明 ===============",
    "type: module —— 源码与启动器是 ESM；Electron 主进程产物是 .cjs（见 scripts/build 注释）",
    "main: lib/app-entry.cjs —— 打包后的应用入口（按 DSH_PET_ROLE 分发：应用主进程 / 桌面 Helper）",
    "bin.dsh-pet —— 启动器（lib/app-launch.js）：找 Electron → 拉起主进程；开发态与全局安装都走它",
    "files —— npm pack/publish 只发运行必需项；便携版由 npm run app:package 生成（dist/，不入库）",
    "scripts.app —— 构建 + 启动（改代码时用）",
    "scripts.app:package —— 打便携版：拷贝 Electron 运行时 + resources/app，产出 dist/dsh-pet-app",
    "scripts.app:smoke —— 端到端冒烟：起 mock OpenAI 端点，验配置/模型/碎碎念/对话/通知帧/工作状态",
    "scripts.build —— 完整构建（tsdown + 桌面共享核心），克隆后手动跑一次；app / app:package 会自动跑",
    "scripts.prepack —— 发布前链：构建 → typecheck/lint/format → prepack-check（产物健康检查）→ openapi 校验",
    "engines —— Node.js 兼容下限（由运行依赖 @electron/get@5.1.0 的 engines 决定）",
    "================================================"
  ],
  "type": "module",
  "main": "lib/app-entry.cjs",
  "bin": {
    "dsh-pet": "lib/app-launch.js"
  },
  "files": [
    "lib",
    "src",
    "assets/webm",
    "runtime/electron-helper",
    "assets/fonts",
    "assets/pic",
    "assets/memes",
    "assets/config.jsonc",
    "assets/logo.png",
    "scripts/package-app.mjs",
    "scripts/ensure-electron.mjs",
    "dsh-pet.cmd",
    "dsh-pet.sh"
  ],
  "scripts": {
    "bundle": "tsdown",
    "build:desktop-core": "node scripts/build-desktop-core.mjs",
    "watch": "tsdown --watch",
    "ensure:electron": "node scripts/ensure-electron.mjs",
    "start:desktop": "node scripts/start-desktop.mjs",
    "build": "node scripts/prepare.js",
    "prepack": "npm run build && npm run typecheck && npm run lint && npm run format:check && node scripts/prepack-check.js && npm run check:openapi",
    "check:openapi": "node scripts/check-openapi.mjs",
    "test": "node --experimental-strip-types --import ./scripts/test-register.mjs --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:ui": "node --test scripts/tests/*.test.mjs",
    "app": "npm run bundle && npm run build:desktop-core && node lib/app-launch.js",
    "app:package": "node scripts/package-app.mjs",
    "app:smoke": "node scripts/app-smoke.mjs",
    "app:installer": "node scripts/package-installer.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@electron-internal/extract-zip": "^1.0.5",
    "@electron/get": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "js-yaml": "^5.4.2",
    "playwright": "1.63.0",
    "prettier": "^3.9.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rolldown": "1.0.0-beta.7",
    "tsdown": "^0.8.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.67.0"
  },
  "author": {
    "name": "luoqingciya"
  }
}
